<Window x:Class="MaterialOrders.MaterialOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Заказы материалов"
        Height="620"
        Width="980"
        MinHeight="520"
        MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Оформление заказов материалов"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,16" />

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14"
                BorderBrush="#D1D5DB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Материал" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="MaterialNameTextBox" Height="34" Padding="10,6" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Количество" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="QuantityTextBox" Height="34" Padding="10,6" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Цена за единицу, ₽" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="UnitPriceTextBox" Height="34" Padding="10,6" />
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Добавить"
                        Height="34"
                        MinWidth="120"
                        Padding="18,6"
                        VerticalAlignment="Bottom"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#1D4ED8"
                        Click="AddMaterialButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Padding="8">
            <DataGrid x:Name="OrdersDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="3*" />
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="*" />
                    <DataGridTextColumn Header="Цена за ед., ₽" Binding="{Binding UnitPrice, StringFormat=N2}" Width="*" />
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalPrice, StringFormat=N2}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Удалить выбранную"
                        Click="DeleteSelectedButton_Click"
                        Height="34"
                        Padding="16,6"
                        Margin="0,0,10,0"
                        Background="#DC2626"
                        Foreground="White"
                        BorderBrush="#B91C1C" />
                <Button Content="Очистить список"
                        Click="ClearAllButton_Click"
                        Height="34"
                        Padding="16,6" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Итого:"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="GrandTotalTextBlock"
                           Text="0.00 ₽"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
